# FinTech Algorithmic Trading Risk Engine & Monte Carlo VaR Analyzer
# Environment Configuration

APP_ENV=development
LOG_LEVEL=INFO

# Simulation & VaR Parameters
DEFAULT_MONTE_CARLO_SIMULATIONS=5000
DEFAULT_TIME_HORIZON_DAYS=1
DEFAULT_CONFIDENCE_LEVEL=0.95
DEFAULT_RANDOM_SEED=42

# Risk Limit Defaults
MAX_PORTFOLIO_LEVERAGE=3.0
MAX_SINGLE_POSITION_WEIGHT=0.25
MAX_PORTFOLIO_VAR_PCT=0.05
MAX_DRAWDOWN_LIMIT_PCT=0.15
MARGIN_CALL_THRESHOLD_PCT=0.85

# Storage & Output
DATA_CACHE_DIR=./data_cache
REPORTS_OUTPUT_DIR=./risk_reports
